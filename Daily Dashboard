<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jed's Dashboard</title>
<style>
  :root {
    --surface-2: #ffffff;
    --surface-1: #f4f3ef;
    --surface-0: #ebeae4;
    --text-primary: #1a1a1a;
    --text-secondary: #5f5e5a;
    --text-muted: #888780;
    --border: #d3d1c7;
    --accent: #185fa5;
    --danger: #a32d2d;
    --radius: 8px;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 2rem 1.5rem;
    background: var(--surface-0);
    color: var(--text-primary);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .wrap { max-width: 720px; margin: 0 auto; }
  .header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
  }
  .header h1 { font-size: 22px; font-weight: 600; margin: 0; }
  .header p { font-size: 13px; color: var(--text-secondary); margin: 2px 0 0; }
  button {
    border: 0.5px solid var(--border);
    background: var(--surface-2);
    border-radius: var(--radius);
    padding: 8px 12px;
    font-size: 13px;
    cursor: pointer;
  }
  button:hover { background: var(--surface-1); }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0,1fr));
    gap: 12px;
    margin-bottom: 1.75rem;
  }
  .stat {
    background: var(--surface-1);
    border-radius: var(--radius);
    padding: 1rem;
  }
  .stat p:first-child { font-size: 13px; color: var(--text-secondary); margin: 0; }
  .stat p:last-child { font-size: 24px; font-weight: 600; margin: 4px 0 0; }
  .columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: start;
  }
  @media (max-width: 600px) {
    .columns { grid-template-columns: 1fr; }
  }
  .col-title {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
    font-size: 14px;
    font-weight: 600;
  }
  .email-row {
    display: flex;
    align-items: center;
    gap: 8px;
    border: 0.5px solid var(--border);
    border-radius: var(--radius);
    padding: 8px 10px;
    margin-bottom: 6px;
    background: var(--surface-2);
  }
  .dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
  .dot.news { background: var(--accent); }
  .dot.promo { background: var(--danger); }
  .email-text { min-width: 0; flex: 1; }
  .email-text .subject {
    font-size: 13px;
    font-weight: 600;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .email-text .sender { font-size: 12px; color: var(--text-muted); margin: 1px 0 0; }
  .event-card {
    border: 0.5px solid var(--border);
    border-radius: var(--radius);
    padding: 0.85rem;
    background: var(--surface-2);
  }
  .event-card .time { font-size: 13px; color: var(--text-muted); margin: 0 0 6px; }
  .event-card .title { font-size: 14px; font-weight: 600; margin: 0; }
  .event-card .loc { font-size: 13px; color: var(--text-secondary); margin: 2px 0 0; }
  .note { font-size: 13px; color: var(--text-muted); margin: 10px 0 0; }
</style>
</head>
<body>
<div class="wrap">
  <div class="header">
    <div>
      <h1>Today</h1>
      <p id="date-label">Loading date...</p>
    </div>
    <button onclick="location.reload()">Refresh</button>
  </div>

  <div class="stats">
    <div class="stat"><p>Unread emails</p><p id="unread-count">9</p></div>
    <div class="stat"><p>Events this week</p><p id="event-count">1</p></div>
    <div class="stat"><p>Next up</p><p>1pm</p></div>
  </div>

  <div class="columns">
    <div>
      <div class="col-title">Inbox</div>
      <div id="inbox-list"></div>
    </div>

    <div>
      <div class="col-title">This week</div>
      <div class="event-card">
        <p class="time">Sat 22 Aug, 1:00 - 4:00pm</p>
        <p class="title">Sailing</p>
        <p class="loc">Royal Queensland Yacht Squadron</p>
      </div>
      <p class="note">Nothing else booked this week.</p>
    </div>
  </div>
</div>

<script>
document.getElementById('date-label').textContent =
  new Date().toLocaleDateString('en-AU', { weekday: 'long', day: 'numeric', month: 'long' }) + ' · Brisbane';

const emails = [
  { sender: "Codecademy", subject: "50% off Pro Annual", cat: "promo" },
  { sender: "TLDR", subject: "Apple AirPods camera leak, Marvell, Waymo", cat: "news" },
  { sender: "TLDR", subject: "GLM-5.3 Release, Hacking SAML", cat: "news" },
  { sender: "TLDR", subject: "AI Coworkers Invade Slack", cat: "news" },
  { sender: "TLDR", subject: "Stark Comes to Claude, iPhone 18 Pro", cat: "news" },
  { sender: "TLDR", subject: "BTC Exceeds $71K, Human Auth", cat: "news" },
  { sender: "TLDR", subject: "OpenAI and Reddit breakup", cat: "news" },
  { sender: "Temu", subject: "You still have AU$260 credits unclaimed", cat: "promo" },
  { sender: "TLDR", subject: "Shopify's E2E testing, Bun 1.4", cat: "news" }
];

const list = document.getElementById('inbox-list');
emails.forEach(function (e) {
  const row = document.createElement('div');
  row.className = 'email-row';
  row.innerHTML =
    '<span class="dot ' + e.cat + '"></span>' +
    '<div class="email-text">' +
      '<p class="subject">' + e.subject + '</p>' +
      '<p class="sender">' + e.sender + '</p>' +
    '</div>';
  list.appendChild(row);
});
</script>
</body>
</html>
